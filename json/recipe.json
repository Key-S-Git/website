  "1": {
    "title": "牛モモ肉ステーキ",
    "thumbnail": "media/album/recipe1/1.jpg",
    "ingredients": [
      { "name": "牛モモ肉", "amount": "200g" },
      { "name": "塩", "amount": "少々" },
      { "name": "胡椒", "amount": "少々" },
      { "name": "サラダ油", "amount": "" }
    ],
    "instructions": [
      { "text": "キッチンペーパーで肉の水気を拭く", "explain": "水分を拭くことで、臭みを取り除き、香ばしく焼くことができる" },
      { "text": "30分放置", "explain": "肉を常温に戻すことで、火が均一に通るようになる" },
      { "text": "肉に塩・胡椒を振る", "explain": "肉内部の水分と一緒に旨味成分が表面に出てくる" },
      { "text": "油をひいて熱したフライパンに肉を乗せる", "explain": "塩・胡椒で味付けした面を下にする" },
      { "text": "強火で1分", "explain": "" },
      { "text": "弱火に落として1分", "explain": "" },
      { "text": "肉を裏返し、強火で30秒", "explain": "" },
      { "text": "弱火に落として1分30秒", "explain": "" },
      { "text": "肉を取り出してアルミホイルに包み、4分休ませる", "explain": "余熱で肉汁が閉じ込められ、ジューシーな仕上がりに" }
    ],
    "album": [
      "media/album/recipe1/1.jpg"
    ]
  },
